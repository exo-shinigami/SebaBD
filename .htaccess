# SebaBD — Apache configuration.
#
# Drop this project into XAMPP's htdocs (or symlink it) and everything below
# applies automatically. Nothing here is required to make the site work; each
# rule closes a gap that would otherwise be visible to a visitor.

# Friendly not-found page. Apache keeps the 404 status; 404.php then renders the
# normal site chrome with a search box and the catalog shortcuts.
ErrorDocument 404 404.php

# ErrorDocument's URL is resolved against the *server's* document root, so on a
# subdirectory install (htdocs/<project>/) it points at a file that does not
# exist and Apache falls back to its own seven-byte "Not Found" body — the page
# above never renders. The rewrite resolves against this directory instead, so
# the friendly page works whatever the folder is called, and the two conditions
# let real files and directories pass through untouched. 404.php answers 404
# with http_response_code() itself, so the status stays correct.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]

# Never serve a PHP source file as text. If PHP ever fails to load, Apache would
# otherwise hand out config.php (database credentials) and the SQL dumps as
# plain files. Denying them outright removes that failure mode.
<FilesMatch "\.(sql|md|log|ini|example\.php)$">
    Require all denied
</FilesMatch>
<Files "config.php">
    Require all denied
</Files>

# Directory listings leak the shape of the project.
Options -Indexes

# Cache the stylesheet and scripts for a week, but never cache PHP responses.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|svg|webp|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store"
    </FilesMatch>
</IfModule>

# Compress text responses when the browser asks for it.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
