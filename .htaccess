# SebaBD — Apache directory & security rules.
#
# Three jobs:
#   1. Send a missing address to 404.php instead of Apache's plain error page.
#      RewriteBase is omitted on purpose so the same file works at the server
#      root and inside a subdirectory such as /Ecommerce%20Website/.
#   2. Keep database dumps, credentials, vendor libraries, internal includes,
#      and local configuration out of the browser.
#   3. Emit baseline HTTP security headers on static and dynamic responses.

Options -Indexes
ServerSignature Off

<IfModule mod_headers.c>
    Header setifempty X-Content-Type-Options "nosniff"
    Header setifempty X-Frame-Options "SAMEORIGIN"
    Header setifempty Referrer-Policy "strict-origin-when-cross-origin"
    Header setifempty Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always unset X-Powered-By
</IfModule>

# A relative ErrorDocument is treated by Apache as a literal message string, so
# a non-existent path goes through mod_rewrite instead: any request that is not
# a real file or directory is handed to 404.php in the same folder.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct HTTP access to internal directories
    RewriteRule ^(database|vendor|scratch|\.freebuff|\.git|partials|reports)(/|$) - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>

<FilesMatch "\.(sql|md|log|ini|txt|json|lock|db|db-shm|db-wal|bat|ps1|sh|example\.php)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(config|db|helpers|catalog-data|cart-data|admin-bootstrap|pdf-document)\.php$">
    Require all denied
</FilesMatch>
